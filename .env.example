# Copy to .env (never commit). Use separate values for dev/staging/prod.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://sonora:sonora@localhost:5432/sonora

# Clerk (https://dashboard.clerk.com) - secret key is server-only
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Initial super admins: comma-separated. Granted ONLY by `npm run provision:admins`
# and ONLY if the Clerk account exists with a verified primary email.
INITIAL_ADMIN_EMAILS=nabinuranw333@gmail.com,nabinuranw906@gmail.com

# S3-compatible private storage (optional until uploads phase)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
